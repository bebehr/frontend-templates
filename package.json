{
  "name": "frontend-templates",
  "version": "0.0.0",
  "private": true,
  "description": "A modular frontend blueprint to kickstart modern web projects. Includes shared base configs and stack-specific branches.",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "scripts": {
    "check": "npm run check:spell",
    "check:copypaste": "jscpd .",
    "check:spell": "cspell . --quiet",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "npm run prettier:write && npm run lint:fix",
    "lint": "npm run lint:formatting && npm run lint:editorconfig && npm run eslint && npm run lint:html && npm run lint:md",
    "lint:editorconfig": "editorconfig-checker",
    "lint:fix": "npm run eslint:fix && npm run lint:md:fix",
    "lint:formatting": "npm run prettier",
    "lint:html": "htmlhint .",
    "lint:md": "markdownlint-cli2 .",
    "lint:md:fix": "markdownlint-cli2 . --fix",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "test": "npm run lint && npm run check:copypaste && npm run check:spell && npm audit"
  },
  "overrides": {
    "@awmottaz/prettier-plugin-void-html": {
      "prettier": "~3.10.1"
    },
    "htmlhint": {
      "glob": "~14.0.6",
      "minimatch": "~11.0.9"
    },
    "markdownlint-cli2": {
      "katex": "~0.19.1"
    }
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^2.3.0",
    "@cspell/dict-de-de": "^4.1.3",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "cspell": "^10.5.2",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.4.3",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
